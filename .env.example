# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000

# Comma-separated list of origins allowed to call the API (your Next.js app).
# Use * to allow any origin (not recommended in production).
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app,https://main.xxxxxx.amplifyapp.com

# Shared secret the frontend must send as the "x-api-key" header.
# Leave empty to disable auth (only do this for local development!).
AGENT_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# AI (OpenAI): understands your request and writes the email for you
# ---------------------------------------------------------------------------
# Leave OPENAI_API_KEY empty to use the simple built-in template instead (no AI, English only).
#
# Pick ONE provider. All of them speak the same "OpenAI-compatible" API:
#
#   OpenAI (paid)       key: https://platform.openai.com/api-keys
#                       OPENAI_BASE_URL=            (leave empty)
#                       OPENAI_MODEL=gpt-4.1-mini
#
#   Google Gemini (free tier)   key: https://aistudio.google.com/apikey
#                       OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                       OPENAI_MODEL=gemini-2.5-flash
#
#   Groq (free tier)    key: https://console.groq.com/keys
#                       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                       OPENAI_MODEL=llama-3.3-70b-versatile
#
#   Ollama (free, runs on this PC, no key)   install from https://ollama.com, then: ollama pull llama3.1
#                       OPENAI_API_KEY=ollama
#                       OPENAI_BASE_URL=http://localhost:11434/v1
#                       OPENAI_MODEL=llama3.1
#
# Model names change over time; if you get AI_MODEL errors, check the provider's model list.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
# Also let the AI summarize search / inbox results. This sends the senders, subjects
# and snippets of those emails to OpenAI. Set to false to keep them local.
OPENAI_SUMMARIZE=true
# Your name, used to sign AI-written emails ("Best regards,\n<name>"). Leave empty to let
# your Gmail signature do it.
SENDER_NAME=

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------
# true  = no separate browser window; watch the agent in the dashboard's Live preview (recommended)
# false = also open a visible Chromium window (for debugging). `npm run login` always opens
#         a visible window regardless of this setting.
HEADLESS=true

# Folder where Chromium stores cookies / local storage so the Gmail login persists.
# Keep this folder private: anyone with it can access the logged-in account.
USER_DATA_DIR=./.browser-profile

# Optional: use your installed Google Chrome instead of bundled Chromium
# ("chrome", "msedge"). Google sign-in is more reliable with real Chrome.
BROWSER_CHANNEL=

# Milliseconds between keystrokes for the typewriter effect (randomised +/- 50%).
TYPING_DELAY_MS=80

# Slows every Playwright action down by N ms (handy for watching the agent locally).
SLOW_MO_MS=0

# Default timeout for waiting on page elements (ms).
ACTION_TIMEOUT_MS=30000

# If true, the agent fills in the email but does NOT click Send (safe testing).
DRY_RUN=false

# ---------------------------------------------------------------------------
# Live browser preview (streams the agent's browser to the dashboard)
# ---------------------------------------------------------------------------
# Works in both headless and headed mode. Frames show your real mailbox, so
# they are only sent to clients that pass the API key.
SCREENCAST_ENABLED=true
# JPEG quality 1-100 (lower = less bandwidth, but small text gets blurry below ~75)
SCREENCAST_QUALITY=80
# Frames wider than this are scaled down (1366 = the browser width, i.e. no scaling)
SCREENCAST_MAX_WIDTH=1366
# Maximum frames per second sent to each viewer
SCREENCAST_MAX_FPS=8
